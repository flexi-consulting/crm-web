    { "name": "crm_deal_repair_catalog_link", "operation": "repair", "scope": "crm.deals.links.repair.synthetic", "inputSchemaRef": "schemas/s04-operation-input.schema.json", "outputSchemaRef": "schemas/synthetic-deal-operation.schema.json", "httpBinding": "POST /api/v1/deal-operations/{operationId}/repair" }
