{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm-web.example.invalid/schemas/s01-catalog-search-input.schema.json",
  "title": "Profile-scoped exhibition catalog search",
  "type": "object",
  "additionalProperties": false,
  "required": ["exhibitionId"],
  "properties": {
    "exhibitionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "query": { "type": "string", "maxLength": 120 },
    "classification": { "enum": ["target", "near_target", "not_target", "unknown"] },
    "country": { "type": "string", "maxLength": 80 },
    "revenueBand": { "enum": ["0-100", "100-1500", "1500+"] },
    "profitBand": { "enum": ["loss", "0-30", "30-200", "200+"] },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
    "offset": { "type": "integer", "minimum": 0, "maximum": 20000, "default": 0 }
  }
}
