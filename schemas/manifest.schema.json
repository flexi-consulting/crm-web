{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm-web.example.invalid/schemas/manifest.schema.json",
  "title": "C14 connected application manifest",
  "type": "object",
  "required": ["serviceId", "release", "platformContractRange", "domainApiVersion", "capabilities", "compatibility", "endpoints"],
  "properties": {
    "serviceId": { "const": "crm-web.exhibitions" },
    "release": {
      "type": "object",
      "required": ["version", "sourceRevision", "environment"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "platformContractRange": { "const": ">=1.0.0 <2.0.0" },
    "domainApiVersion": { "const": "1.0.0" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "compatibility": {
      "type": "object",
      "required": ["deprecatedCapabilities"],
      "properties": {
        "deprecatedCapabilities": { "type": "array", "items": { "$ref": "#/$defs/deprecatedCapability" } }
      },
      "additionalProperties": false
    },
    "endpoints": {
      "type": "object",
      "required": ["readiness", "catalog"],
      "properties": {
        "readiness": { "$ref": "#/$defs/endpoint" },
        "catalog": { "$ref": "#/$defs/endpoint" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["method", "path"],
      "properties": {
        "method": { "const": "GET" },
        "path": { "type": "string", "pattern": "^/api/v1/" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["id", "version", "required", "inputSchemaRef", "outputSchemaRef", "effect", "requiredScopes", "operationRef"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "required": { "type": "boolean" },
        "inputSchemaRef": { "type": "string", "pattern": "^schemas/[^ ]+\\.schema\\.json$" },
        "outputSchemaRef": { "type": "string", "pattern": "^schemas/[^ ]+\\.schema\\.json$" },
        "effect": { "enum": ["read", "write", "external_mutation"] },
        "requiredScopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "operationRef": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "deprecatedCapability": {
      "type": "object",
      "required": ["id", "version", "replacement"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "replacement": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
