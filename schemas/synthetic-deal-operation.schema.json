{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm-web.example.invalid/schemas/synthetic-deal-operation.schema.json",
  "title": "Synthetic deal operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["domainApiVersion", "operationId", "status", "companyId", "exhibitionId", "replayed"],
  "properties": {
    "domainApiVersion": { "const": "1.0.0" },
    "operationId": { "type": "string", "pattern": "^op-[0-9a-f-]{36}$" },
    "status": { "enum": ["pending", "created", "unknown", "rejected"] },
    "companyId": { "type": "string", "pattern": "^(demo-company-[0-9]{3}|co-[a-f0-9]{20})$" },
    "exhibitionId": { "type": "string", "pattern": "^demo-expo-[0-9]{3}$" },
    "buildId": { "type": "string", "pattern": "^build-[a-f0-9]{24}$" },
    "dealId": { "type": "string", "pattern": "^demo-deal-[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "linkStatus": { "const": "linked" },
    "replayed": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "created" } }, "required": ["status"] },
      "then": { "required": ["dealId"] }
    }
  ]
}
