{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm-web.example.invalid/schemas/company-list.schema.json",
  "title": "Synthetic visible companies response",
  "type": "object",
  "required": ["domainApiVersion", "items"],
  "properties": {
    "domainApiVersion": { "const": "1.0.0" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "country", "exhibitionIds", "exhibitions", "qualification"],
        "properties": {
          "id": { "type": "string", "pattern": "^demo-company-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "country": { "type": "string", "minLength": 1 },
          "exhibitionIds": { "type": "array", "items": { "type": "string", "pattern": "^demo-expo-[0-9]{3}$" } },
          "exhibitions": { "type": "array", "items": { "type": "object", "required": ["id", "name", "city", "country", "startsOn", "endsOn", "website"], "properties": { "id": { "type": "string", "pattern": "^demo-expo-[0-9]{3}$" }, "name": { "type": "string" }, "city": { "type": "string" }, "country": { "type": "string" }, "startsOn": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" }, "endsOn": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" }, "website": { "type": "string", "pattern": "^https://" } }, "additionalProperties": false } },
          "qualification": { "type": "object", "required": ["qualification", "reason"], "properties": { "qualification": { "enum": ["target", "review", "unreviewed"] }, "reason": { "type": "string", "minLength": 1 } }, "additionalProperties": false }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
