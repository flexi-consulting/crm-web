{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm-web.example.invalid/schemas/prelead-timeline-event.schema.json",
  "title": "Append-only prelead timeline event",
  "type": "object",
  "required": ["eventId", "operationId", "sequence", "type", "payload", "occurredAt"],
  "properties": {
    "eventId": { "type": "string", "pattern": "^evt-[0-9a-f-]{36}$" },
    "operationId": { "type": "string", "pattern": "^op-[0-9a-f-]{36}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["note_added", "rejection_added", "rejection_undone"] },
    "payload": { "type": "object" },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "note_added" },
        "payload": {
          "type": "object", "required": ["noteText"],
          "properties": { "noteText": { "type": "string", "minLength": 1, "maxLength": 1000 } },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": { "const": "rejection_added" },
        "payload": {
          "type": "object", "required": ["reason"],
          "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": { "const": "rejection_undone" },
        "payload": {
          "type": "object", "required": ["targetEventId"],
          "properties": { "targetEventId": { "type": "string", "pattern": "^evt-[0-9a-f-]{36}$" } },
          "additionalProperties": false
        }
      }
    }
  ],
  "additionalProperties": false
}
