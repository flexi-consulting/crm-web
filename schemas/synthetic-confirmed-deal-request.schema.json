{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm-web.example.invalid/schemas/synthetic-confirmed-deal-request.schema.json",
  "title": "Synthetic confirmed deal request",
  "type": "object",
  "additionalProperties": false,
  "required": ["companyId", "exhibitionId", "title", "summary", "confirmation", "operationId"],
  "properties": {
    "companyId": { "type": "string", "pattern": "^demo-company-[0-9]{3}$" },
    "exhibitionId": { "type": "string", "pattern": "^demo-expo-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "confirmation": { "const": true },
    "operationId": { "type": "string", "pattern": "^op-[0-9a-f-]{36}$" }
  }
}
